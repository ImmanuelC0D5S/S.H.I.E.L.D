# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Secrets - only .env.example is tracked
.env
.env.*
!.env.example

# Credential files. These carry live private keys: the Firebase admin
# service-account JSON can push to every FCM topic, and google-services.json
# carries the Firebase API key. Both must never reach git.
secrets/
firebase-adminsdk*.json
service-account*.json
app/*.json
app/**/google-services.json
*.jks
*.keystore

# Supabase CLI local state (may contain an access token)
supabase/.temp/
supabase/.branches/

# Models and datasets are large and machine-specific
rpi/models/
rpi/known_faces/
rpi/datasets/
rpi/runs/
backend/data/
backend/snapshots/
*.log
*.bak
events.jsonl

# Biometric media - never commit.
# These are photographs of identifiable people: the operator, their friends,
# and the WIDER FACE dataset. rpi/datasets/ above covers the labelled captures.
# NOTE: gitignore has no inline comments - keep each pattern on its own line.
rpi/enroll_photos/
datasets/
review/
*.npy
*.pt
*.pth
*.onnx
*.tflite
*.h5
*.pkl
*.joblib
*.jpg
*.jpeg
*.png
*.bmp
*.webp
*.mp4
*.avi
*.wav
*.mp3

# Android / Gradle
#
# `**/build/` not `build/`. The Gradle project root is `app/` and the module is
# `app/app/`, so the artifact directory is `app/app/build/` - two levels deep. A
# one-level pattern matches nothing, and the first `git add app` would have
# committed ~2000 generated files including the merged google-services values.
app/**/build/
app/**/.gradle/
app/.gradle/
app/local.properties
*.apk
*.aab

# Room schema history is committed on purpose (it is what a Migration diff is
# written against), but the generated DAO/DB implementations are not. The build
# directory already covers them; this is belt and braces for anyone who moves
# the module.
*_Impl.java
*_Impl.class

# ESP32 firmware
#
# secrets.h carries SHIELD_HMAC_KEY and the Wi-Fi PSK. *.h is not ignored
# globally, so this needs its own pattern -- one `git add .` away from a
# forgeable sensor link otherwise. Same reasoning as D-045.
firmware/**/secrets.h
firmware/esp32/build/
firmware/esp32/sdkconfig
firmware/esp32/managed_components/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Project documentation is local-only.
#
# README.md is the exception and is tracked. Everything else -- DECISIONS.md,
# HANDOFF.md, PLAN.md, docs/PROTOCOL.md and the shield-*-prompt.md briefs --
# stays on disk and out of the repository, so the design record and the
# authoritative protocol spec are not published to a remote that may outlive
# the hardware they describe.
#
# `*.md` then `!README.md`: order matters in gitignore, the last matching
# pattern wins, so the negation has to come after the wildcard.
*.md
!README.md
