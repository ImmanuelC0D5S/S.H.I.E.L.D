// secrets.h.example -- copy to secrets.h and fill in.
//
//     cp secrets.h.example secrets.h
//
// secrets.h is gitignored. It carries the Wi-Fi PSK and the sensor-link HMAC
// key (docs/PROTOCOL.md 2.5), so a committed copy means anyone who ever clones
// this repo can forge a frame on shield-net. Never commit it, never log it.

#pragma once

// Wi-Fi client credentials. The Pi runs the AP; SSID and PSK must match
// SHIELD_WIFI_SSID / SHIELD_WIFI_PSK in the Pi's .env (PROTOCOL.md 2.1).
#define WIFI_SSID "shield-net"
#define WIFI_PASS "CHANGE_ME"

// Where the Pi's link server listens (PROTOCOL.md 2.1: 192.168.50.1:8765).
#define RPI_HOST "192.168.50.1"
#define RPI_PORT 8765

// HMAC-SHA256 key for every frame, both directions (PROTOCOL.md 2.5).
// Minimum 32 bytes of entropy, e.g. `openssl rand -hex 32`.
// The value must be byte-identical to SHIELD_LINK_KEY in the Pi's .env -- the
// firmware macro is named SHIELD_HMAC_KEY per shield-esp32-firmware-pass.md,
// but it is the same secret. Must NOT equal the Wi-Fi PSK.
#define SHIELD_HMAC_KEY "CHANGE_ME_32_BYTES_OF_RANDOM"

// Optional wall-clock seed, Unix seconds.
//
// shield-net has no internet path, so the node cannot reach NTP and
// `sent_at` (PROTOCOL.md 2.4) would otherwise read 1970 forever. Put the time
// of flashing here to make the event log readable. 0 = leave the clock unset.
// This is advisory only: the link never validates sent_at, and ts_ms is
// monotonic milliseconds, which does not need a clock.
#define TIME_SEED_EPOCH_S 0UL
