<?xml version="1.0" encoding="utf-8"?>
<!--
  allowBackup="false" is set in the manifest, so these rules govern only the
  device-to-device transfer path on Android 12+, which allowBackup does not fully
  cover.

  Nothing here is eligible. The SQLCipher database holds signed storage URLs of
  photographs of the user's home, and the Keystore-wrapped passphrase that opens
  it must not leave the device either - restoring one without the other produces
  an app that cannot open its own database and says nothing about why.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>