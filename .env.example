# Copy to .env and fill in. .env is gitignored. Never commit real values.

# --- Sensor link (ESP32 <-> RPi Wi-Fi, see docs/PROTOCOL.md section 2) ---
# Must match CONFIG_SHIELD_WIFI_PSK and CONFIG_SHIELD_LINK_KEY on the ESP32.
SHIELD_WIFI_SSID=shield-net
SHIELD_WIFI_PSK=
# HMAC key for sensor-link frames. Minimum 32 bytes of entropy. Must NOT equal
# SHIELD_API_TOKEN and must NOT equal SHIELD_WIFI_PSK.
SHIELD_LINK_KEY=

# --- Backend ---
# Shared bearer token. RPi and Android app both send this.
SHIELD_API_TOKEN=change-me
# HMAC key for snapshot signed URLs.
SNAPSHOT_SIGNING_KEY=change-me-too

# --- RPi -> backend ---
SHIELD_BACKEND_URL=http://192.168.1.50:8000

# --- Modem (SIM7600 HAT or USB LTE dongle) ---
SHIELD_MODEM_PORT=/dev/ttyUSB1
SHIELD_MODEM_BAUD=115200
SHIELD_MODEM_SMS_NUMBER=
SHIELD_MODEM_APN=internet

# --- Device identity, sent as device_id in every alert ---
SHIELD_DEVICE_ID=shield-01