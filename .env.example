# Copy to .env and fill in. .env is gitignored. Never commit real values.
#
# NOTE: do not put spaces around the '=' signs. `set -a; . ./.env` and most
# dotenv loaders mishandle `KEY = value`, and a shell will silently export a
# variable whose name is "KEY " which nothing ever reads.
#
# Validate this file and generate the Firebase block with:
#   powershell -File tools\supabase_secrets.ps1

# --- Supabase ---
# Project ref for this deployment. The RPi, the Edge Function and the app all
# talk to this one project; a ref mismatch is the single most likely cause of
# "migrations applied but the app sees nothing".
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (new format: sb_publishable_...). The Android app ships this
# one; it is not a secret, and it is gated by RLS.
SUPABASE_KEY=
# Secret key (new format: sb_secret_..., the successor to service_role).
# RPi and Edge Function only. Never put this in the APK.
SUPABASE_SERVICE_KEY=

# --- Firebase (used by the send-alert Edge Function ONLY) ---
# The RPi never holds these. The Edge Function owns the FCM push so the admin
# private key exists in exactly one place. See DECISIONS.md D-044.
FCM_PROJECT_ID=
# Compact single line, no real line breaks. Generate with:
#   jq -c . secrets/fcm-service-account.json
# or tools/supabase_secrets.ps1, which does the same thing without jq.
FCM_SERVICE_ACCOUNT_JSON=

# --- Webhook ---
# Shared by the Database Webhook on events INSERT and the send-alert function,
# which compares it against the x-webhook-secret header and returns 401 on
# mismatch. 32 random bytes: openssl rand -hex 32
WEBHOOK_SECRET=

# --- Sensor link (ESP32 <-> RPi Wi-Fi, PROTOCOL.md section 2) ---
# Must match CONFIG_SHIELD_WIFI_PSK and CONFIG_SHIELD_LINK_KEY on the ESP32.
SHIELD_WIFI_SSID=shield-net
SHIELD_WIFI_PSK=
# HMAC key for sensor-link frames. Minimum 32 bytes of entropy. Must NOT equal
# SUPABASE_SERVICE_KEY and must NOT equal SHIELD_WIFI_PSK. The same value goes
# in the ESP32 secrets.h as CONFIG_SHIELD_LINK_KEY.
SHIELD_LINK_KEY=
# PROTOCOL.md section 2.1 pins 8765. Do not change one without the other.
LINK_PORT=8765

# --- RPi -> Supabase ---
# Sent as device_id in every alert.
SHIELD_DEVICE_ID=shield-01
# JWT the RPi authenticates to PostgREST with. role=shield_rpi, NOT service_role,
# so RLS still applies to it. Mint one with:
#   python tools/mint_role_token.py --role shield_rpi --print-env
# Requires SUPABASE_JWT_SECRET above. load_config() raises without it rather than
# running unauthenticated, so the RPi refuses to start if this is missing. The
# default TTL is 90 days; re-mint on expiry or every insert fails with 401.
SUPABASE_RPI_TOKEN=

# --- Behaviour ---
# How long the RPi waits for events.verdict before escalating to the buzzer.
VERDICT_TIMEOUT_S=60
# New triggers inside this window after an alert are ignored.
COOLDOWN_S=30

# --- Snapshot signing (kept for PROTOCOL.md section 3.6 parity) ---
# Minimum 32 bytes: openssl rand -hex 32
SNAPSHOT_SIGNING_KEY=